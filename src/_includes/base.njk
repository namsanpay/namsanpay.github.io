<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = (title + " | " + site.name) if title else site.title %}
{% set pageDesc = description or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="index,follow,max-snippet:-1">
{% if site.naverVerification %}<meta name="naver-site-verification" content="{{ site.naverVerification }}">{% endif %}
{% if site.googleVerification %}<meta name="google-site-verification" content="{{ site.googleVerification }}">{% endif %}
<meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="ko_KR">
<meta property="og:image" content="{{ site.url }}/assets/brand/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/assets/brand/mark.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
{% block head %}{% endblock %}
</head>
<body>
<a class="skip" href="#content">본문 바로가기</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="{{ site.brand }} 홈"><img class="brand-logo" src="/assets/brand/logo-header.svg" alt="{{ site.brand }}" width="282" height="44"><span class="brand-sub">급여아웃소싱 · {{ site.name }}</span></a>
    <nav aria-label="주요 메뉴" class="nav">
      <a href="/#scope">업무 범위</a>
      <a href="/#price">비용</a>
      <a href="/#clients">주요 고객 업종</a>
      <a href="/special-workers/"{% if page.url == '/special-workers/' %} aria-current="page"{% endif %}>노무제공자 보험 신고</a>
      <a href="/workplace-innovation/"{% if page.url == '/workplace-innovation/' %} aria-current="page"{% endif %}>일터혁신 컨설팅</a>
      <a href="/#faq">자주 묻는 질문</a>
      <a href="/board/"{% if page.url and page.url.startsWith('/board/') %} aria-current="page"{% endif %}>급여 실무 정보</a>
      <a class="btn btn-primary btn-sm" href="/#contact">견적 문의</a>
    </nav>
  </div>
</header>
<main id="content">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-col">
      <img class="footer-logo" src="/assets/brand/logo-full.svg" alt="NAMSAN PAY 남산PAY · {{ site.name }} 급여아웃소싱" width="291" height="52">
      <strong>{{ site.name }}</strong>
      {% if site.ceo %}<span>대표 공인노무사 {{ site.ceo }}</span>{% endif %}
      {% if site.bizNo %}<span>사업자등록번호 {{ site.bizNo }}</span>{% endif %}
      {% if site.email %}<span>이메일 <a href="mailto:{{ site.email }}">{{ site.email }}</a></span>{% endif %}
      {% if site.hours %}<span>상담시간 {{ site.hours }}</span>{% endif %}
    </div>
    {% for o in site.offices %}{% if o.address %}
    <div class="footer-col">
      <strong>{{ o.label }}</strong>
      <span>{{ o.address }}</span>
      {% if o.phone %}<span>전화 <a href="tel:{{ o.phone.split('~')[0] }}">{{ o.phone }}</a>{% if o.fax %} · 팩스 {{ o.fax }}{% endif %}</span>{% endif %}
    </div>
    {% endif %}{% endfor %}
    <div class="footer-col">
      {% if site.mainSite %}<a href="{{ site.mainSite }}">노무법인 남산 홈페이지</a>{% endif %}
      <a href="/privacy/">개인정보처리방침</a>
    </div>
  </div>
</footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
(() => {
  const toast = document.getElementById('toast');
  let t;
  const show = (msg) => { toast.textContent = msg; toast.classList.add('on'); clearTimeout(t); t = setTimeout(() => toast.classList.remove('on'), 2600); };
  document.querySelectorAll('a[href^="mailto:"]').forEach(a => {
    a.addEventListener('click', () => {
      const addr = a.getAttribute('href').slice(7).split('?')[0];
      try {
        navigator.clipboard.writeText(addr).then(() => show(addr + ' 주소가 복사되었습니다'), () => {});
      } catch (e) {}
    });
  });
})();
</script>
</body>
</html>
